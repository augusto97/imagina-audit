# Dependencies
frontend/node_modules/
# `frontend/dist/` es un intermedio del build — el deploy real es
# `deploy/output/` (armado por `deploy/build.sh`, viaja en el repo).
frontend/dist/

# Environment
backend/.env
backend/.env.*
!backend/.env.example
deploy/output/.env
deploy/output/.env.*
*.db

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
backend/logs/*.log
backend/cache/*.json

# Build
*.tsbuildinfo

# Test dependencies (dev only, never deployed)
backend/vendor/
backend/.phpunit.cache/
backend/composer.lock
frontend/coverage/

# Zip artifacts inside deploy/output — el zip versionado vive en la rama 'release',
# no en feature branches. Si build.sh o un manual copy lo deja aquí, lo ignoramos.
deploy/output/*.zip
